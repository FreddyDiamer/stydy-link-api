#  домен для продакшна
kai-study-link.ru {
    reverse_proxy app:3000
    
    # Автоматический HTTPS
    tls your-email@example.com
    
    # Сжатие
    encode gzip

    handle /api/* {
        reverse_proxy app:3000
    }
    
    # Кэширование статических файлов
    @static {
        path *.css *.js *.png *.jpg *.jpeg *.gif *.ico *.svg
    }
    header @static Cache-Control "public, max-age=31536000"
}