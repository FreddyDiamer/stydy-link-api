DATABASE_URL=postgresql://username@localhost:5432/study_link?schema=public

JWT_SECRET=your-super-secret-jwt-key-change-in-production-make-it-longer-than-32-chars-feafafafaefafafae
JWT_EXPIRES_IN=7d

TELEGRAM_BOT_TOKEN=bot_token
# Секрет вебхука бота (16–256 символов A-Z a-z 0-9 _ -); вебхук регистрируется на FRONTEND_BASE_URL/api/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=

FRONTEND_BASE_URL=https://your-miniapp-url.com

# Числовые Telegram ID администраторов через запятую, например 852915881 (не id пользователя в базе); пусто — никто
ADMIN_TELEGRAM_IDS=

PORT=3000
NODE_ENV=development